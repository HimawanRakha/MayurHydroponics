# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---- Project-specific: keep the repo to what the website needs ----

# AI agent / editor tooling
/.claude/
/AGENTS.md
/CLAUDE.md
.vscode/
.idea/

# Internal planning & audit documents (not needed to build or run the site)
/docs/

# Raw source assets from the owner (large originals). Web-ready copies live in
# src/assets/images and public/logo; regenerate with `npm run images` locally.
/Asset Project Website/

# Local-only helper scripts
/scripts/screenshot.sh

# OS / misc
Thumbs.db
*.log
